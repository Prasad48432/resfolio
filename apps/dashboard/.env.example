# Copy to .env.local for local development (never commit real values).
# Validated by @resfolio/env — the build fails on missing/invalid vars.

# docker-compose.dev.yml Postgres (host port 5433 — 5432 is left free for a
# natively installed Postgres).
DATABASE_URL=postgres://resfolio:resfolio@localhost:5433/resfolio

# openssl rand -base64 32
BETTER_AUTH_SECRET=32-character-secret
BETTER_AUTH_URL=http://localhost:3001

# OAuth apps (redirect URIs):
#   Google  → http://localhost:3001/api/auth/callback/google
#   GitHub  → http://localhost:3001/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional — Upstash-backed auth rate limiting (in-memory fallback without).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional — the "Print view" affordance on resumes. Both must be set (and
# RENDER_SECRET must match apps/sites) to mint a print-route URL; absent,
# the button is hidden. Full cloud PDF delivery lands later.
# RENDER_SECRET=at-least-16-characters
# SITES_URL=http://localhost:3002

# Optional — kill switch for resume PDF export. Set to "false" to turn it OFF:
# the Download-PDF button hides and the export route refuses (503), so no
# request reaches apps/sites or the PDF microservice (a cost/safety lever).
# Unset (or "true") keeps it enabled. Takes effect on the next deploy.
# PDF_EXPORT_ENABLED=false

# Optional — Sentry (no-op without).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Optional — pino level (trace|debug|info|warn|error|fatal, default info).
# LOG_LEVEL=debug

# Optional — encrypts provider tokens at rest (oauth2/token connectors on
# /sources). 64 hex chars (32 bytes), e.g. `openssl rand -hex 32`. Every V1
# connector is public and stores no credentials, so this is unused today.
# INTEGRATIONS_TOKEN_KEY=

# Optional — raises GitHub's anonymous rate limit for /sources imports from
# 60 req/hour *per IP* (shared by every user of this deployment) to 5,000.
# Not authentication: any classic PAT with NO scopes ticked works, it grants
# no access to anyone's private data, and imports work without it.
# GITHUB_TOKEN=

# --- Cloudflare R2 (uploads) -------------------------------------------------
# Optional as a group: with any of these absent, uploads are unavailable and
# the dashboard hides the upload controls rather than failing when a user
# picks a file. All five are needed together.
#
# Create the token under R2 → Manage API tokens, scoped **Object Read & Write
# on this bucket only** — an admin or account-wide token hands a leaked
# credential the entire account.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
#
# The delivery origin — how a stored key becomes a public URL. The bucket's
# r2.dev development URL works to start; note Cloudflare rate-limits it and
# advises against it for production, so expect to move to a custom domain on
# the bucket. That move is a change to this value and nothing else: asset keys
# are origin-independent and `assetKeyFromUrl` matches on the key, not the host.
# R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# ── Blog ────────────────────────────────────────────────────────────────
# How many images a single post may embed. Optional — unset means the
# domain's default of 5. Configurable rather than hardcoded so raising it
# (a paid tier, or because 5 proved stingy) is a deployment setting, not a
# release. Enforced at upload *and* in the repository, so a body assembled
# another way can't exceed it either.
# BLOG_MAX_IMAGES_PER_POST=5

# apps/sites — the rendering host (docs/architecture/09-rendering-pipeline.md)

# HMAC secret for signed, short-lived print/preview-route tokens (min 16 chars).
# The dashboard and the export job must mint tokens with the SAME secret.
PRINT_TOKEN_SECRET="change-me-to-a-long-random-string"

# Only needed for the DB-backed render sources ("draft" / "version"). The
# fixture source (dev/CI, used by the PDF export spike) needs no database.
# Postgres note: a native Windows Postgres shadows 5432 — dev uses 5433.
# DATABASE_URL="postgres://resfolio:resfolio@localhost:5433/resfolio"

# Optional: base URL the export script targets (defaults to localhost:3002).
# SITES_URL="http://localhost:3002"
